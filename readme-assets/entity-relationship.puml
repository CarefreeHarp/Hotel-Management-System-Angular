@startuml entity-relationship
' Modelo de la base de datos de Atlan Suites, igual a las entidades JPA del backend.
' Para regenerar el PNG (no requiere Graphviz, usa el motor de PlantUML):
'   java -jar plantuml.jar -tpng readme-assets/entity-relationship.puml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam nodesep 40
skinparam ranksep 60

' ───────────── Usuarios ─────────────
entity "ADMINISTRATOR" as administrator {
  * admin_id : INT <<PK, auto_increment>>
  --
  * name : VARCHAR(60) [NOT NULL]
  * email : VARCHAR(100) [NOT NULL, UNIQUE]
  * password : VARCHAR(255) [NOT NULL]
}

entity "OPERATOR" as operator {
  * operator_id : INT <<PK, auto_increment>>
  --
  * name : VARCHAR(60) [NOT NULL]
  * last_name : VARCHAR(60) [NOT NULL]
  * email : VARCHAR(100) [NOT NULL, UNIQUE]
  * password : VARCHAR(255) [NOT NULL]
  * admin_id : INT <<FK>> [NOT NULL] -- [ON DELETE RESTRICT]
}

entity "CLIENT" as client {
  * client_id : INT <<PK, auto_increment>>
  --
  * name : VARCHAR(60) [NOT NULL]
  * last_name : VARCHAR(60) [NOT NULL]
  * national_id : VARCHAR(20) [NOT NULL, UNIQUE]
  * phone : VARCHAR(20) [NOT NULL]
  * email : VARCHAR(100) [NOT NULL, UNIQUE]
  * password : VARCHAR(255) [NOT NULL]
  profile_photo : VARCHAR(500) [NULLABLE]
}

' ───────────── Alojamiento ─────────────
entity "ROOM_TYPE" as room_type {
  * room_type_id : INT <<PK, auto_increment>>
  --
  * name : VARCHAR(50) [NOT NULL, UNIQUE]
  * description : VARCHAR(500) [NOT NULL]
  * nightly_price : DECIMAL(10,2) [NOT NULL]
  * max_capacity : INT [NOT NULL]
  * main_photo : VARCHAR(500) [NOT NULL]
}

entity "ROOM_TYPE_SECONDARY_PHOTO" as room_type_photo {
  * room_type_id : INT <<FK>> [NOT NULL] -- [ON DELETE CASCADE]
  --
  * photo_url : VARCHAR(500) [NOT NULL]
}

entity "ROOM" as room {
  * room_id : INT <<PK, auto_increment>>
  --
  * room_number : INT [NOT NULL, UNIQUE]
  * floor : INT [NOT NULL]
  * status : VARCHAR(20) [NOT NULL] -- AVAILABLE, OCCUPIED, CLEANING, MAINTENANCE
  * activation_status : VARCHAR(8) [NOT NULL] -- ACTIVE, INACTIVE
  * room_type_id : INT <<FK>> [NOT NULL] -- [ON DELETE RESTRICT]
}

' ───────────── Servicios ─────────────
entity "SERVICE" as service {
  * service_id : INT <<PK, auto_increment>>
  --
  * name : VARCHAR(100) [NOT NULL]
  * url_name : VARCHAR(100) [NOT NULL, UNIQUE]
  * description : TEXT [NOT NULL]
  * price : DECIMAL(10,2) [NOT NULL]
  * category : VARCHAR(50) [NOT NULL]
  * activation_status : VARCHAR(8) [NOT NULL] -- ACTIVE, INACTIVE
  summary : VARCHAR(255) [NULLABLE]
  duration : VARCHAR(50) [NULLABLE]
  availability : VARCHAR(100) [NULLABLE]
  location : VARCHAR(100) [NULLABLE]
  * main_image_url : VARCHAR(500) [NOT NULL]
}

entity "SERVICE_SECONDARY_IMAGE" as service_image {
  * service_id : INT <<FK>> [NOT NULL] -- [ON DELETE CASCADE]
  --
  * image_url : VARCHAR(500) [NOT NULL]
}

' ───────────── Reservas ─────────────
entity "RESERVATION" as reservation {
  * reservation_id : INT <<PK, auto_increment>>
  --
  * reservation_code : VARCHAR(30) [NOT NULL, UNIQUE]
  * check_in_date : DATE [NOT NULL]
  * check_out_date : DATE [NOT NULL]
  * guest_count : INT [NOT NULL]
  * nightly_price : DECIMAL(10,2) [NOT NULL]
  * status : VARCHAR(20) [NOT NULL] -- PENDING, CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED
  * created_at : DATETIME [NOT NULL]
  client_id : INT <<FK>> [NULLABLE] -- [ON DELETE SET NULL]
  room_id : INT <<FK>> [NULLABLE] -- [ON DELETE RESTRICT]
}

entity "RESERVATION_SERVICE" as reservation_service {
  * reservation_id : INT <<FK>> [NOT NULL] -- [ON DELETE CASCADE]
  * service_id : INT <<FK>> [NOT NULL] -- [ON DELETE RESTRICT]
}

entity "RATING" as rating {
  * rating_id : INT <<PK, auto_increment>>
  --
  * reservation_id : INT <<FK, UNIQUE>> [NOT NULL] -- [ON DELETE CASCADE]
  * score : INT [NOT NULL] -- 1 to 5
  comment : VARCHAR(500) [NULLABLE]
  * created_at : DATETIME [NOT NULL]
}

' ───────────── Facturación ─────────────
entity "FOLIO" as folio {
  * folio_id : INT <<PK, auto_increment>>
  --
  * reservation_id : INT <<FK, UNIQUE>> [NOT NULL] -- [ON DELETE CASCADE]
  * status : VARCHAR(20) [NOT NULL] -- PENDING, PAID, CANCELLED
  * issued_at : DATETIME [NOT NULL]
}

entity "FOLIO_ITEM" as folio_item {
  * folio_item_id : INT <<PK, auto_increment>>
  --
  * folio_id : INT <<FK>> [NOT NULL] -- [ON DELETE CASCADE]
  service_id : INT <<FK>> [NULLABLE] -- [ON DELETE RESTRICT]
  * concept : VARCHAR(150) [NOT NULL]
  * unit_price : DECIMAL(10,2) [NOT NULL]
  * quantity : INT [NOT NULL]
  * charged_at : DATETIME [NOT NULL]
}

entity "PAYMENT" as payment {
  * payment_id : INT <<PK, auto_increment>>
  --
  * folio_id : INT <<FK>> [NOT NULL] -- [ON DELETE CASCADE]
  operator_id : INT <<FK>> [NULLABLE] -- [ON DELETE SET NULL]
  * amount : DECIMAL(10,2) [NOT NULL]
  * payment_method : VARCHAR(30) [NOT NULL] -- CARD, CASH
  * status : VARCHAR(20) [NOT NULL] -- APPROVED, PENDING, REJECTED
  * paid_at : DATETIME [NOT NULL]
}

entity "REFUND" as refund {
  * refund_id : INT <<PK, auto_increment>>
  --
  * folio_id : INT <<FK>> [NOT NULL] -- [ON DELETE CASCADE]
  operator_id : INT <<FK>> [NULLABLE] -- [ON DELETE SET NULL]
  * amount : DECIMAL(10,2) [NOT NULL]
  * refund_method : VARCHAR(30) [NOT NULL] -- CARD, CASH
  * reason : VARCHAR(20) [NOT NULL] -- CANCELLATION, MODIFICATION
  * status : VARCHAR(20) [NOT NULL] -- APPROVED, PENDING, REJECTED
  notes : VARCHAR(255) [NULLABLE]
  * refunded_at : DATETIME [NOT NULL]
}

' ───────────── Relaciones ─────────────
room_type ||-right-o{ room_type_photo : "has [ON DELETE CASCADE]"
room_type ||--o{ room : "classifies [ON DELETE RESTRICT]"
administrator ||--o{ operator : "creates [ON DELETE RESTRICT]"
client |o--o{ reservation : "places [ON DELETE SET NULL]"
room |o--o{ reservation : "assigned to [ON DELETE RESTRICT]"
reservation ||-right-o| rating : "rated with [ON DELETE CASCADE]"
reservation ||--o{ reservation_service : "includes [ON DELETE CASCADE]"
service ||-left-o{ reservation_service : "contracted in [ON DELETE RESTRICT]"
service ||--o{ service_image : "has [ON DELETE CASCADE]"
reservation ||--|| folio : "generates [ON DELETE CASCADE]"
folio ||--o{ folio_item : "contains [ON DELETE CASCADE]"
service |o--o{ folio_item : "billed as [ON DELETE RESTRICT]"
folio ||--o{ payment : "settled with [ON DELETE CASCADE]"
operator |o--o{ payment : "processes [ON DELETE SET NULL]"
folio ||--o{ refund : "refunded with [ON DELETE CASCADE]"
operator |o--o{ refund : "processes [ON DELETE SET NULL]"

' Orden horizontal: solo ubica las tablas, no son relaciones.
folio -[hidden]right- reservation_service
payment -[hidden]right- refund

@enduml
